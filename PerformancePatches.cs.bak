[HarmonyPatch(typeof(AtmosphericsManager))]
public static class AtmosphericsManager_Patch
{
    public static int FindCount = 0;
    public static int RegisterCount = 0;
    public static int DeregisterCount = 0;
    public static long FindTicksTotal = 0;
    
    public static readonly ConcurrentDictionary<long, Atmosphere> AllWorldAtmospheresLookUp_Long = new ConcurrentDictionary<long, Atmosphere>(Environment.ProcessorCount, 65535);
    public static void Init() {
        // copy data from original dictionary to long-based dictionary
        AllWorldAtmospheresLookUp_Long.Clear();
        foreach (var kvp in AtmosphericsManager.AllWorldAtmospheresLookUp)        {
            AllWorldAtmospheresLookUp_Long[CalcKey(kvp.Key)] = kvp.Value;
        }
        StationeersProfilingPlugin.Log($"AtmosphericsManager_Patch initialized, copied {AllWorldAtmospheresLookUp_Long.Count} atmospheres to long-based dictionary");
    }
    public static void Deinit() {
        // copy data back
        AtmosphericsManager.AllWorldAtmospheresLookUp.Clear();
        foreach (var kvp in AllWorldAtmospheresLookUp_Long)        {
            AtmosphericsManager.AllWorldAtmospheresLookUp[kvp.Value.WorldGrid] = kvp.Value;
        }
        StationeersProfilingPlugin.Log($"AtmosphericsManager_Patch deinitialized, copied {AllWorldAtmospheresLookUp_Long.Count} atmospheres back to original dictionary");
    }

    public static long CalcKey(WorldGrid worldGrid)
    {
        var grid = worldGrid.Value;
        return ((long)grid.x << 40) | ((long)grid.y << 20) | (long)grid.z;
    }

    // ---------------------------
    // FIND
    // ---------------------------
    [HarmonyPatch("Find", new Type[] { typeof(WorldGrid) })]
    [HarmonyPrefix]
    public static bool Find_Prefix(WorldGrid worldGrid, ref Atmosphere __result)
    {
        var sw = Stopwatch.StartNew();
        FindCount++;
        AllWorldAtmospheresLookUp_Long.TryGetValue(CalcKey(worldGrid), out var value);
        __result = value;
        Interlocked.Add(ref FindTicksTotal, sw.ElapsedTicks);
        return false; // skip original
    }

    // ---------------------------
    // REGISTER
    // ---------------------------
    [HarmonyPatch("Register", new Type[] { typeof(Atmosphere) })]
    [HarmonyPrefix]
    public static bool Register_Prefix(Atmosphere atmosphere)
    {
        RegisterCount++;
        if (AtmosphericsManager.AllAtmospheres.Add(atmosphere))
        {
            atmosphere.RegisteredWorldGrid = atmosphere.WorldGrid;

            if (atmosphere.Mode == AtmosphereHelper.AtmosphereMode.World)
            {
                var key = CalcKey(atmosphere.WorldGrid);

                if (!AllWorldAtmospheresLookUp_Long.TryAdd(key, atmosphere))
                {
                    ConsoleWindow.PrintError(
                        "Duplicate world atmosphere registered at " +
                        StringManager.GetGridString(atmosphere.WorldGrid)
                    );
                }
            }
        }

        return false; // skip original
    }

    // ---------------------------
    // DEREGISTER
    // ---------------------------
    [HarmonyPatch("Deregister", new Type[] { typeof(Atmosphere) })]
    [HarmonyPrefix]
    public static bool Deregister_Prefix(Atmosphere atmosphere)
    {
        DeregisterCount++;
        if (atmosphere == null)
            return false;

        atmosphere.BeingDestroyed = true;

        if (atmosphere.Mode == AtmosphereHelper.AtmosphereMode.World)
        {
            PlanetaryAtmosphereSimulation.GiveToGlobal(atmosphere.GasMixture);
            atmosphere.GasMixture.Reset();

            AtmosphericFire.DeRegister(atmosphere);
            AtmosphericFog.DeRegister(atmosphere);

            var key = CalcKey(atmosphere.WorldGrid);

            AllWorldAtmospheresLookUp_Long.TryRemove(key, out _);

            atmosphere.RegisteredWorldGrid = WorldGrid.INVALID;
        }

        Referencable.Deregister(atmosphere);

        if (NetworkManager.IsServer && NetworkServer.HasClients())
        {
            lock (AtmosphericsManager.DeregisteredAtmospheres)
            {
                AtmosphericsManager.DeregisteredAtmospheres.Add(atmosphere.ReferenceId);
            }
        }

        return false; // skip original
    }
}